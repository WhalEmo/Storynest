<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Storynest"
        parent="Theme.Material3.DayNight.NoActionBar">

        <item name="textInputStyle">@style/Widget.Storynest.TextInputLayout</item>

        <item name="colorPrimary">#F0D8C0</item>

        <item name="colorError">@color/error_red</item>

    </style>
    <style name="Theme.Storynest"
    parent="Base.Theme.Storynest" />
    <style name="Theme.MyApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
    </style>

    <style name="Widget.Storynest.TextInputLayout"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">


        <!-- Basılmadan önce (idle) -->
        <item name="boxStrokeColor">#F0D8C0</item>
        <item name="hintTextColor">#F0D8C0</item>

        <!-- Error yazısı -->
        <item name="errorTextColor">#F0D8C0</item>


        <item name="boxStrokeWidth">2dp</item>
        <!-- Error -->
        <item name="boxStrokeErrorColor">@color/error_red</item>


    </style>

    <style name="Theme.Storynest" parent="Base.Theme.Storynest" />

    <style name="StoryNestCustomInputStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="colorControlActivated">@color/colorPrimary</item>
        <item name="android:textColorHighlight">@color/soft_blue</item>
    </style>


    <style name="Widget.StoryNest.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/colorPrimary</item>
        <item name="hintTextColor">@color/colorPrimary</item>
        <item name="android:textColorHint">@color/reject_gray</item>
        <item name="cursorColor">@color/colorPrimary</item>

        <item name="errorTextColor">@color/red_error</item>
        <item name="boxStrokeErrorColor">@color/red_error</item>
        <item name="errorIconTint">@color/red_error</item>

        <item name="boxCornerRadiusTopStart">10dp</item>
        <item name="boxCornerRadiusTopEnd">10dp</item>
        <item name="boxCornerRadiusBottomStart">10dp</item>
        <item name="boxCornerRadiusBottomEnd">10dp</item>

        <item name="theme">@style/StoryNestCustomInputStyle</item>
    </style>


</resources>