<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- USER LAYOUT -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardUserProfile"
            android:layout_width="36dp"
            android:layout_height="36dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/imgUserProfile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/account_circle_24" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/txtUsername"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="kullanici_adi"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/cardUserProfile"
            app:layout_constraintTop_toTopOf="@id/cardUserProfile"
            app:layout_constraintEnd_toStartOf="@id/btnPostMenu"
            app:layout_constraintBottom_toBottomOf="@id/cardUserProfile"/>

        <ImageButton
            android:id="@+id/btnPostMenu"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/menu_post"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/cardUserProfile"
            app:layout_constraintBottom_toBottomOf="@id/cardUserProfile"/>

        <!-- KATEGORİ -->
        <TextView
            android:id="@+id/txtCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fantastik"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#AAAAAA"
            app:layout_constraintTop_toBottomOf="@id/cardUserProfile"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="8dp"/>

        <!-- KAPAK + BAŞLIK -->
        <ImageView
            android:id="@+id/coverImage"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:scaleType="centerCrop"
            android:src="@drawable/outline_broken_image_24"
            app:layout_constraintTop_toBottomOf="@id/txtCategory"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="6dp"/>

        <TextView
            android:id="@+id/txtPostName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Hikâye Başlığı"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            app:layout_constraintStart_toEndOf="@id/coverImage"
            app:layout_constraintTop_toTopOf="@id/coverImage"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- TARİH -->
        <TextView
            android:id="@+id/txtPostDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12 Mart 2025"
            android:textSize="11sp"
            android:paddingTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/coverImage"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- HİKÂYE METNİ (KISITLI) -->
        <TextView
            android:id="@+id/txtContents"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Uzun hikâye metni buraya gelecek..."
            android:textSize="15sp"
            android:lineSpacingExtra="6dp"
            android:maxLines="8"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@id/txtPostDate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="4dp"/>

        <!-- DEVAMINI GÖR -->
        <TextView
            android:id="@+id/txtReadMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Devamını gör"
            android:textStyle="bold"
            android:textColor="#1E88E5"
            android:clickable="true"
            app:layout_constraintTop_toBottomOf="@id/txtContents"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="4dp"/>

        <!-- ALT BAR -->
        <ImageView
            android:id="@+id/btnLike"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/baseline_favorite_border_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtReadMore"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/txtLikeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="120"
            android:textStyle="bold"
            android:textSize="13sp"
            app:layout_constraintStart_toEndOf="@id/btnLike"
            app:layout_constraintTop_toTopOf="@id/btnLike"
            android:layout_marginStart="4dp"/>

        <ImageView
            android:id="@+id/btnComment"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/outline_comment_24"
            app:layout_constraintStart_toEndOf="@id/txtLikeCount"
            app:layout_constraintTop_toTopOf="@id/btnLike"
            android:layout_marginStart="20dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>